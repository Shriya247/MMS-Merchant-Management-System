
<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================
         SPRING BOOT PARENT
    ====================================== -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>


    <!-- =====================================
         PROJECT DETAILS
    ====================================== -->

    <groupId>com.mms</groupId>
    <artifactId>mms</artifactId>
    <version>2.0.0-SNAPSHOT</version>

    <name>MMS</name>

    <description>
        Merchant Management System using
        Spring Boot, Thymeleaf, Spring Security
        and MySQL
    </description>

    <packaging>jar</packaging>


    <!-- =====================================
         JAVA VERSION
    ====================================== -->

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>


    <!-- =====================================
         DEPENDENCIES
    ====================================== -->

    <dependencies>

        <!-- =================================
             1. SPRING WEB
             Controllers, HTTP, Tomcat
        ================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!-- =================================
             2. THYMELEAF
             HTML templates and th: attributes
        ================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>


        <!-- =================================
             3. SPRING SECURITY
             Admin login, logout, authorization
        ================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>


        <!-- =================================
             4. THYMELEAF SECURITY SUPPORT
             Integration with Spring Security
        ================================== -->

        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>


        <!-- =================================
             5. JDBC
             JdbcTemplate and SQL queries
        ================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>


        <!-- =================================
             6. MYSQL DRIVER
             Connect Spring Boot to MySQL
        ================================== -->

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>


        <!-- =================================
             7. VALIDATION
             Bean Validation support
        ================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>


        <!-- =================================
             8. SPRING BOOT TESTING
             JUnit 5 and Spring Test
        ================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- =================================
             9. SPRING SECURITY TESTING
             Mock users and authorization tests
        ================================== -->

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <!-- =====================================
         BUILD CONFIGURATION
    ====================================== -->

    <build>

        <finalName>mms-2.0</finalName>

        <plugins>

            <!-- SPRING BOOT MAVEN PLUGIN -->

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>

    </build>

</project>
